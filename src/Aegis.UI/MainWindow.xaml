<Window
    x:Class="Aegis.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Aegis Control Center">

    <Grid Padding="30" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="5">
            <TextBlock Text="Aegis Control Center" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="Local-First Content Filtering &amp; Commitment Device" FontSize="14" Foreground="Gray" />
        </StackPanel>

        <!-- Protection Banner -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="20">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock x:Name="TxtStatusTitle" Text="Protection Active &amp; Locked" FontSize="18" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    <TextBlock x:Name="TxtStatusDetail" Text="All critical enforcement modules healthy. 25-day commitment timer active." FontSize="13" Foreground="#94A3B8"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="BtnRefresh" Content="Refresh Health" Click="OnRefreshClicked" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Health Cards -->
        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="10">
                <TextBlock Text="Subsystem Health Snapshot" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,5"/>

                <Border Background="#0F172A" CornerRadius="6" Padding="15">
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Windows Service" FontWeight="Medium"/>
                            <TextBlock Text="Hosts API server and global state coordinator" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtServiceStatus" Text="Healthy" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="#0F172A" CornerRadius="6" Padding="15">
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SQLite Database" FontWeight="Medium"/>
                            <TextBlock Text="Local persistence in WAL mode with row HMAC integrity" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtDbStatus" Text="Healthy" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="#0F172A" CornerRadius="6" Padding="15">
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="DNS Proxy Filter" FontWeight="Medium"/>
                            <TextBlock Text="Local UDP 127.0.0.1:53 listener for domain blocklists" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtDnsStatus" Text="Healthy" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Background="#0F172A" CornerRadius="6" Padding="15">
                    <Grid ColumnSpacing="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Browser Extension" FontWeight="Medium"/>
                            <TextBlock Text="MV3 Chromium agent for URL and DOM keyword evaluation" FontSize="12" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TxtExtensionStatus" Text="Healthy" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
